<?xml version="1.0" ?>

<robot name="rover2_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rover2_arm" params="parent *origin name:=rover_arm" >
    <!-- <xacro:include filename="$(find rover_arm_description)/urdf/rover_arm.trans" /> -->
    <!-- <xacro:include filename="$(find rover_arm_description)/urdf/rover_arm.gazebo" /> -->

    <link name="${name}_base_link">
      <inertial>
        <origin xyz="-0.0009447828005189041 0.08468497648772827 0.03949082514116446" rpy="0 0 0"/>
        <mass value="1.9803212654096218"/>
        <inertia ixx="0.003733" iyy="0.007147" izz="0.007072" ixy="1e-06" iyz="-3e-06" ixz="0.001344"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Base_Link-URDF_Mass.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Base_Collision.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${name}_shoulder">
      <inertial>
        <origin xyz="-0.0005179666729459471 -0.009703141635556661 0.11413506870321072" rpy="0 0 0"/>
        <mass value="4.597426515663195"/>
        <inertia ixx="0.034023" iyy="0.017924" izz="0.026762" ixy="-0.000625" iyz="-0.000848" ixz="-1e-05"/>
      </inertial>
      <visual>
        <origin xyz="0.0 -0.055 -0.0865" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Shoulder_Link-URDF_Mass.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0.0 -0.055 -0.0865" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Shoulder_Collision.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${name}_long_arm">
      <inertial>
        <origin xyz="0.003255341560779442 0.08225313572805198 0.3038514362100365" rpy="0 0 0"/>
        <mass value="1.931219575863863"/>
        <inertia ixx="0.103823" iyy="0.102679" izz="0.003018" ixy="-4.5e-05" iyz="-0.00607" ixz="-0.00024"/>
      </inertial>
      <visual>
        <origin xyz="-0.064949 -0.052429 -0.237943" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Long_Arm_Link-URDF_Mass.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="-0.064949 -0.052429 -0.237943" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Long_Arm_Collision.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${name}_elbow_roll">
      <inertial>
        <origin xyz="0.0028418040335443616 0.062929193683773 0.002447775776976968" rpy="0 0 0"/>
        <mass value="1.6182387209715599"/>
        <inertia ixx="0.002773" iyy="0.002583" izz="0.001869" ixy="-9e-06" iyz="-1e-05" ixz="3.1e-05"/>
      </inertial>
      <visual>
        <origin xyz="0.059204 -0.057343 -0.739926" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Elbow_Roll_Link-URDF_Mass.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0.059204 -0.057343 -0.739926" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Elbow_Roll_Collision.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${name}_short_arm">
      <inertial>
        <origin xyz="0.0008005407654101404 0.019869467859255252 0.3086627160724952" rpy="0 0 0"/>
        <mass value="2.3532339025644338"/>
        <inertia ixx="0.029335" iyy="0.024849" izz="0.007089" ixy="-0.000181" iyz="-0.001871" ixz="-7.4e-05"/>
      </inertial>
      <visual>
        <origin xyz="0.124153 -0.059914 -0.790926" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Short_Arm_Link-URDF_Mass.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0.124153 -0.059914 -0.790926" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Short_Arm_Collision.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${name}_wrist_roll">
      <inertial>
        <origin xyz="-0.08875188207831092 -0.016654911934429514 -0.03711756226850449" rpy="0 0 0"/>
        <mass value="1.3442681899530171"/>
        <inertia ixx="0.002669" iyy="0.002554" izz="0.00167" ixy="-1.6e-05" iyz="-8.4e-05" ixz="-9e-06"/>
      </inertial>
      <visual>
        <origin xyz="0.059204 -0.057343 -1.139326" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Wrist_Roll_Link-URDF-Mass.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0.059204 -0.057343 -1.139326" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Wrist_Roll_Collision.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${name}_tool0">
      <inertial>
        <origin xyz="4.7031710182124375e-05 0.000453106103411427 0.01635440962044843" rpy="0 0 0"/>
        <mass value="0.09744608224670866"/>
        <inertia ixx="3.3e-05" iyy="3.4e-05" izz="5.6e-05" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
      </inertial>
      <visual>
        <origin xyz="0.009243 -0.055366 -1.165364" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Tool0-URDF_Mass.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0.009243 -0.055366 -1.165364" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Tool0_Collision.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${name}_gripper">
      <inertial>
        <origin xyz="-0.0034288329615621872 4.165532799299543e-05 0.09155079805740618" rpy="0 0 0"/>
        <mass value="1.436142089281915"/>
        <inertia ixx="0.00626" iyy="0.004291" izz="0.003365" ixy="-0.000241" iyz="-0.000136" ixz="8e-05"/>
      </inertial>
      <visual>
        <origin xyz="0.01459598 -0.05420133 -1.189494" rpy="0 0 0.097633718357"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/mr2526-arm-Gripper-2019-URDF_Mass.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.570796632679 0 3.141592653589793"/>
        <geometry>
          <mesh filename="package://rover_arm_urdf/urdf/stl_files/arm_1819_gripper.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${name}_jaws_link">
      <visual> 
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.005" length="0.01"/>
        </geometry>
      </visual>
    </link>

    <joint name="${name}_body_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <joint name="${name}_base_joint" type="revolute">
      <origin xyz="0.055 0.0 0.08648" rpy="0 0 -1.5708"/>
      <parent link="${name}_base_link"/>
      <child link="${name}_shoulder"/>
      <axis xyz="0.0 0.0 -1.0"/>
      <limit upper="1.570796" lower="-1.570796" effort="100" velocity="100"/>
    </joint>

    <joint name="${name}_shoulder_joint" type="revolute">
      <origin xyz="0.064949 -0.002571 0.151443" rpy="0 0 0"/>
      <parent link="${name}_shoulder"/>
      <child link="${name}_long_arm"/>
      <axis xyz="1.0 0.0 0.0"/>
      <limit upper="1.570796" lower="-1.570796" effort="100" velocity="100"/>
    </joint>

    <joint name="${name}_elbow_pitch_joint" type="revolute">
      <origin xyz="-0.124153 0.004914 0.501983" rpy="0 0 0"/>
      <parent link="${name}_long_arm"/>
      <child link="${name}_elbow_roll"/>
      <axis xyz="1.0 0.0 0.0"/>
      <limit upper="3.141593" lower="-3.141593" effort="100" velocity="100"/>
    </joint>

    <joint name="${name}_elbow_roll_joint" type="revolute">
      <origin xyz="-0.064949 0.002571 0.051" rpy="0 0 0"/>
      <parent link="${name}_elbow_roll"/>
      <child link="${name}_short_arm"/>
      <axis xyz="0.0 0.0 -1.0"/>
      <limit upper="3.141593" lower="-3.141593" effort="100" velocity="100"/>
    </joint>

    <joint name="${name}_wrist_pitch_joint" type="revolute">
      <origin xyz="0.064949 -0.002571 0.34838" rpy="0 0 0"/>
      <parent link="${name}_short_arm"/>
      <child link="${name}_wrist_roll"/>
      <axis xyz="1.0 0.0 0.0"/>
      <limit upper="3.141593" lower="-3.141593" effort="100" velocity="100"/>
    </joint>

    <joint name="${name}_wrist_roll_joint" type="continuous">
      <origin xyz="0.049961 -0.001978 0.026058" rpy="0 0 0"/>
      <parent link="${name}_wrist_roll"/>
      <child link="${name}_tool0"/>
      <axis xyz="0.0 0.0 1.0"/>
    </joint>

    <joint name="${name}_gripper_joint" type="fixed">
      <origin xyz="0.0 0.0 0.02413" rpy="0 0 0"/>
      <parent link="${name}_tool0"/>
      <child link="${name}_gripper"/>
    </joint>

    <joint name="${name}_gripper_jaws" type="fixed">
      <parent link = "${name}_gripper"/>
      <child link = "${name}_jaws_link"/> 
      <origin rpy="0 0 0" xyz="0 0 0.236"/>
    </joint>

  </xacro:macro>
</robot>
