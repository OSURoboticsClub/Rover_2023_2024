<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="rover_ros2_control" params="name initial_positions_file ros2_control_hardware_type:=main attachment:=arm">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
              <xacro:if value="${ros2_control_hardware_type == 'main'}">
                <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
                <param name="can">can1</param>
              </xacro:if>
              <xacro:if value="${ros2_control_hardware_type == 'sim'}">
                <plugin>mock_components/GenericSystem</plugin>
              </xacro:if>
              <xacro:if value="${ros2_control_hardware_type == 'gazebo'}">
                <plugin>ign_ros2_control/GazeboSystem</plugin>
              </xacro:if>
            </hardware>
            <joint name="rover_arm_base_joint">
                <param name="node_id">0</param>
                <xacro:if value="${attachment == 'arm'}">
                  <param name="gear_ratio">400.0</param>
                </xacro:if>
                <xacro:if value="${attachment == 'northrop_arm'}">
                  <param name="gear_ratio">1.0</param>
                </xacro:if>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['rover_arm_base_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="rover_arm_shoulder_joint">
                <param name="node_id">1</param>
                <xacro:if value="${attachment == 'arm'}">
                  <param name="gear_ratio">640.0</param>
                </xacro:if>
                <xacro:if value="${attachment == 'northrop_arm'}">
                  <param name="gear_ratio">1.0</param>
                </xacro:if>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['rover_arm_shoulder_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="rover_arm_elbow_pitch_joint">
                <param name="node_id">2</param>
                <xacro:if value="${attachment == 'arm'}">
                  <param name="gear_ratio">393.6</param>
                </xacro:if>
                <xacro:if value="${attachment == 'northrop_arm'}">
                  <param name="gear_ratio">1.0</param>
                </xacro:if>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['rover_arm_elbow_pitch_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="rover_arm_elbow_roll_joint">
                <param name="node_id">3</param>
                <xacro:if value="${attachment == 'arm'}">
                  <param name="gear_ratio">120.0</param>
                </xacro:if>
                <xacro:if value="${attachment == 'northrop_arm'}">
                  <param name="gear_ratio">1.0</param>
                </xacro:if>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['rover_arm_elbow_roll_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="rover_arm_wrist_pitch_joint">
                <param name="node_id">4</param>
                <xacro:if value="${attachment == 'arm'}">
                  <param name="gear_ratio">370.0</param>
                </xacro:if>
                <xacro:if value="${attachment == 'northrop_arm'}">
                  <param name="gear_ratio">1.0</param>
                </xacro:if>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['rover_arm_wrist_pitch_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="rover_arm_wrist_roll_joint">
                <param name="node_id">5</param>
                <xacro:if value="${attachment == 'arm'}">
                  <param name="gear_ratio">100.0</param>
                </xacro:if>
                <xacro:if value="${attachment == 'northrop_arm'}">
                  <param name="gear_ratio">1.0</param>
                </xacro:if>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['rover_arm_wrist_roll_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
