<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="rover_body_ros2_control" params="name initial_positions_file ros2_control_hardware_type:=main controller_config_path:='$(find rover2_control)/config/rover_drive.yaml'">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${ros2_control_hardware_type == 'main'}">
                    <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
                    <param name="can">can0</param>
                </xacro:if>
                <xacro:if value="${ros2_control_hardware_type == 'sim'}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:if value="${ros2_control_hardware_type == 'gazebo'}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
            </hardware>
            
            <joint name="rover_front_left_wheel_joint">
                <param name="node_id">0</param>
                <param name="gear_ratio">-50</param>
                <!-- <command_interface name="position"/> -->
                <command_interface name="velocity"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_front_left_wheel_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="rover_middle_left_wheel_joint">
                <param name="node_id">2</param>
                <param name="gear_ratio">-50</param>
                <!-- <command_interface name="position"/> -->
                <command_interface name="velocity"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_middle_left_wheel_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="rover_back_left_wheel_joint">
                <param name="node_id">4</param>
                <param name="gear_ratio">-50</param>
                <!-- <command_interface name="position"/> -->
                <command_interface name="velocity"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_back_left_wheel_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

            <joint name="rover_front_right_wheel_joint">
                <param name="node_id">1</param>
                <param name="gear_ratio">50</param>
                <!-- <command_interface name="position"/> -->
                <command_interface name="velocity"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_front_right_wheel_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="rover_middle_right_wheel_joint">
                <param name="node_id">3</param>
                <param name="gear_ratio">50</param>
                <!-- <command_interface name="position"/> -->
                <command_interface name="velocity"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_middle_right_wheel_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="rover_back_right_wheel_joint">
                <param name="node_id">5</param>
                <param name="gear_ratio">50</param>
                <!-- <command_interface name="position"/> -->
                <command_interface name="velocity"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_back_right_wheel_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>
        <ros2_control  name="${name}_passive" type="system">
            <hardware>
                <xacro:if value="${ros2_control_hardware_type == 'main'}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:if value="${ros2_control_hardware_type == 'sim'}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:if value="${ros2_control_hardware_type == 'gazebo'}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
            </hardware>
            <joint name="rover_front_left_link_joint">
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_front_left_link_joint']}</param>
                </state_interface>
            </joint>
            <joint name="rover_back_left_link_joint">
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_back_left_link_joint']}</param>
                </state_interface>
            </joint>
            <joint name="rover_front_left_bogie_joint">
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_front_left_bogie_joint']}</param>
                </state_interface>
            </joint>
            <!-- Four Bar linkage doesn't exist in URDF's -->
            <!-- <joint name="rover_back_left_bogie_joint">
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_back_left_bogie_joint']}</param>
                </state_interface>
            </joint> -->



            <joint name="rover_front_right_link_joint">
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_front_right_link_joint']}</param>
                </state_interface>
            </joint>
            <joint name="rover_back_right_link_joint">
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_back_right_link_joint']}</param>
                </state_interface>
            </joint>
            <joint name="rover_front_right_bogie_joint">
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_front_right_bogie_joint']}</param>
                </state_interface>
            </joint>
            <!-- Four Bar linkage doesn't exist in URDF's -->
            <!-- <joint name="rover_back_right_bogie_joint">
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_back_right_bogie_joint']}</param>
                </state_interface>
            </joint> -->

            
            <joint name="rover_rear_bogie_joint">
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['rover_rear_bogie_joint']}</param>
                </state_interface>
            </joint>
        </ros2_control>
        <!-- <gazebo>
            <plugin filename="libign_ros2_control-system.so"
                    name="ign_ros2_control::System">
            </plugin>
        </gazebo> -->
        <gazebo>
            <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>${controller_config_path}</parameters>
            </plugin>
        </gazebo>

    </xacro:macro>
</robot>

            
