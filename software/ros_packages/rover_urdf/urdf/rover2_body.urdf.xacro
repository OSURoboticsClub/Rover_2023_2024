<?xml version="1.0"?>
<!--
Urdf of the rovers chassis and bogies
-->
<robot name="rover_body" xmlns:xacro="https://ros.org/wiki/xacro">
    <xacro:macro name="rover_body" params="name:=rover hardware_type:=main">
        <!-- Set wheel direction -->
        <xacro:property name="wheel_direction" value="1.0"/>
        <xacro:if value="${hardware_type == 'main'}">
            <xacro:property name="wheel_direction" value="-1.0"/>
        </xacro:if>

        <!-- Main Body -->
        <link name="${name}_base_origin">
            <inertial>
                <origin xyz="-0.020724642566662354 -0.05844745645636643 0.05154978430558717" rpy="0 0 0"/>
                <mass value="3.305"/>
                <inertia ixx="1.005454" iyy="0.345354" izz="1.345504" ixy="0.000209" iyz="0.000651" ixz="-1e-06"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 1.5708"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-chassis-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 1.5708"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-chassis-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <link name="${name}_ebox">
            <inertial>
                <origin xyz="-1.3886096659053437e-05 0.013938279999192449 0.10039348035264294" rpy="0 0 0"/>
                <mass value="9.576"/>
                <inertia ixx="2.31987" iyy="3.547055" izz="4.565988" ixy="-0.006577" iyz="-0.004296" ixz="-0.000824"/>
            </inertial>
            <visual>
                <origin xyz="0.020767 -0.065047 -0.065565" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-ebox-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="0.020767 -0.065047 -0.065565" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-ebox-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <link name="${name}_tower">
