            </collision>
        </link>

        <!-- Right Bogie -->
        <link name="${name}_back_right_link">
            <inertial>
                <origin xyz="-0.019570796271520807 0.00548895352163109 0.0027491690281810713" rpy="0 0 0"/>
                <mass value="0.364"/>
                <inertia ixx="0.003449" iyy="0.003114" izz="0.000969" ixy="-0.000205" iyz="-0.001104" ixz="-0.000566"/>
            </inertial>
            <visual>
                <origin xyz="0.220157 0.170002 -0.051277" rpy="0 0 0"/>
                <geometry>
