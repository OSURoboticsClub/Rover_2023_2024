                <mass value="0.091"/>
                <inertia ixx="0.000572" iyy="0.000742" izz="0.000224" ixy="-2.5e-05" iyz="7.8e-05" ixz="0.000172"/>
            </inertial>
            <visual>
                <origin xyz="-0.178623 0.244132 -0.051277" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-bogies-Front_Left_Link-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="-0.178623 0.244132 -0.051277" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-bogies-Front_Left_Link-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link> 

        <link name="${name}_back_left_link">
            <inertial>
                <origin xyz="0.01945611872363137 0.005320192392320233 0.003607951843025717" rpy="0 0 0"/>
                <mass value="0.364"/>
                <inertia ixx="0.002895" iyy="0.00277" izz="0.000653" ixy="0.000123" iyz="-0.000731" ixz="0.000489"/>
            </inertial>
            <visual>
                <origin xyz="-0.178623 0.170002 -0.051277" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-bogie-Back_Left_Link-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="-0.178623 0.170002 -0.051277" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-bogie-Back_Left_Link-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <link name="${name}_left_bogie">
            <inertial>
                <origin xyz="0.059365111463295234 0.02536575473284622 0.0071034284788743" rpy="0 0 0"/>
                <mass value="3.458"/>
                <inertia ixx="0.653142" iyy="0.053673" izz="0.688928" ixy="-6.9e-05" iyz="-0.000892" ixz="0.002443"/>
            </inertial>
            <visual>
                <origin xyz="-0.213548 0.232703 0.026526" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-bogies-Front_Left_Bogie-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="-0.213548 0.232703 0.026526" rpy="0 0 0"/>
                <geometry>
