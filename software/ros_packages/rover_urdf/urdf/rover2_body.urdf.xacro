        <link name="${name}_front_right_link">
            <inertial>
                <origin xyz="-0.02781094690403882 0.001985602612095183 -0.041859015751707196" rpy="0 0 0"/>
                <mass value="0.091"/>
                <inertia ixx="0.000572" iyy="0.000753" izz="0.000215" ixy="8e-06" iyz="2.6e-05" ixz="-0.000174"/>
            </inertial>
            <visual>
                <origin xyz="0.220157 0.244132 -0.051277" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-bogies-Front_Right_Link-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="0.220157 0.244132 -0.051277" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-bogies-Front_Right_Link-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <link name="${name}_right_bogie">
            <inertial>
                <origin xyz="-0.057722558371560706 -0.025644866217060497 0.005871988359208647" rpy="0 0 0"/>
                <mass value="3.458"/>
                <inertia ixx="0.671608" iyy="0.056814" izz="0.707091" ixy="5.1e-05" iyz="-0.030934" ixz="-0.002591"/>
            </inertial>
            <visual>
                <origin xyz="0.256783 0.189661 0.024864" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-bogies-Right_Bogie-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="0.256783 0.189661 0.024864" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-bogies-Right_Bogie-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <!-- Wheels -->
        <link name="${name}_back_left_wheel">
            <inertial>
                <origin xyz="-0.012978027291351724 -1.1418544554331334e-08 2.454435980911787e-05" rpy="0 0 0"/>
                <mass value="1.037"/>
                <inertia ixx="1.075009" iyy="0.75393" izz="0.753965" ixy="-1.4e-05" iyz="1.3e-05" ixz="-0.000624"/>
            </inertial>
            <visual>
                <origin xyz="-0.403212 -0.361145 0.027315" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-Back_Left-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="-0.403212 -0.361145 0.027315" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-Back_Left-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <link name="${name}_back_right_wheel">
            <inertial>
                <origin xyz="0.012975237620860336 -7.447955978623355e-07 -2.5535491847073627e-05" rpy="0 0 0"/>
                <mass value="1.037"/>
                <inertia ixx="1.076472" iyy="0.755021" izz="0.755045" ixy="-0.0" iyz="-4e-06" ixz="-0.000639"/>
            </inertial>
            <visual>
                <origin xyz="0.445048 -0.361145 0.025667" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-Back_Right-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="0.445048 -0.361145 0.025667" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-Back_Right-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <link name="${name}_front_left_wheel">
            <inertial>
                <origin xyz="-0.013051547458098334 5.528400617293983e-07 1.9331428871213752e-07" rpy="0 0 0"/>
                <mass value="1.037"/>
                <inertia ixx="1.15101" iyy="0.802868" izz="0.802857" ixy="-6e-06" iyz="-7e-06" ixz="5e-06"/>
            </inertial>
            <visual>
                <origin xyz="-0.404151 0.407328 0.026769" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-front_left-URDF_collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="-0.404151 0.407328 0.026769" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-front_left-URDF_collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>  

        <link name="${name}_front_right_wheel">
            <inertial>
                <origin xyz="0.01277680877379167 1.2004986695846043e-06 1.0134981184226066e-06" rpy="0 0 0"/>
                <mass value="1.037"/>
                <inertia ixx="0.978665" iyy="0.683272" izz="0.68324" ixy="-2.4e-05" iyz="2.2e-05" ixz="1.1e-05"/>
            </inertial>
            <visual>
                <origin xyz="0.445177 0.414833 0.035551" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-Wheels-Front_Right-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="0.445177 0.414833 0.035551" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-Wheels-Front_Right-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <link name="${name}_middle_left_wheel">
            <inertial>
                <origin xyz="-0.013050556132574054 1.313006088837082e-08 9.706035133082158e-07" rpy="0 0 0"/>
                <mass value="1.037"/>
                <inertia ixx="1.915685" iyy="1.336138" izz="1.336161" ixy="-1.7e-05" iyz="-1.7e-05" ixz="-1.6e-05"/>
            </inertial>
            <visual>
                <origin xyz="-0.404151 0.007278 0.026213" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-middle_left-URDF_collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="-0.404151 0.007278 0.026213" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-middle_left-URDF_collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>

        <link name="${name}_middle_right_wheel">
            <inertial>
                <origin xyz="-0.0009589877347745968 -8.759886766188801e-07 -6.360672008924595e-07" rpy="0 0 0"/>
                <mass value="1.037"/>
                <inertia ixx="0.974983" iyy="0.680605" izz="0.680583" ixy="-1e-06" iyz="1.2e-05" ixz="-1e-05"/>
            </inertial>
            <visual>
                <origin xyz="0.444931 0.015233 0.016585" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-Middle_Right-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <origin xyz="0.444931 0.015233 0.016585" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-wheels-Middle_Right-URDF_Collision.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>


        <!-- Joints -->
        <!-- Rigid body -->
        <joint name="${name}_ebox_joint" type="fixed">
            <origin xyz="-0.065047 -0.020767 0.065565" rpy="0 0 1.5708"/>
            <parent link="${name}_base_origin"/>
            <child link="${name}_ebox"/>
        </joint>

        <joint name="${name}_tower_joint" type="fixed">
            <origin xyz="0.0 0.0 0.0" rpy="0 0 1.5708"/>
            <parent link="${name}_base_origin"/>
            <child link="${name}_tower"/>
        </joint>
        
        <!-- Passive Joints -->
        <joint name="${name}_rear_bogie_joint" type="revolute">
            <origin xyz="-0.333874 -0.020767 0.051277" rpy="0 0 1.5708"/>
            <parent link="${name}_base_origin"/>
            <child link="${name}_rear_bogie"/>
            <axis xyz="0.0 1.0 0.0"/>
            <limit upper="0.2617994" lower="-0.2617994" effort="100" velocity="100"/>
            <dynamics damping="2.0" friction="0.2"/>
        </joint>


        <joint name="${name}_front_left_link_joint" type="fixed">
            <origin xyz="0.244132 0.178623 0.051277" rpy="0 0 1.5708"/>
            <parent link="${name}_base_origin"/>
            <child link="${name}_front_left_link"/>
            <axis xyz="1.0 0.0 0.0"/>
            <limit upper="0.2617994" lower="-0.2617994" effort="100" velocity="100"/>
            <dynamics damping="2.0" friction="0.2"/>
        </joint>
        <joint name="${name}_back_left_link_joint" type="fixed">
            <origin xyz="0.170002 0.178623 0.051277" rpy="0 0 1.5708"/>
            <parent link="${name}_base_origin"/>
            <child link="${name}_back_left_link"/>
            <!-- <axis xyz="1.0 0.0 0.0"/>
            <limit upper="0.2617994" lower="-0.2617994" effort="100" velocity="100"/> -->
        </joint>
        <joint name="${name}_front_left_bogie_joint" type="fixed">
            <origin xyz="0.036626 0.062229 -0.077732" rpy="0 0 0"/>
            <parent link="${name}_front_left_link"/>
            <child link="${name}_left_bogie"/>
            <axis xyz="1.0 0.0 -0.0"/>
            <limit upper="0.2617994" lower="-0.2617994" effort="100" velocity="100"/>
            <dynamics damping="2.0" friction="0.2"/>
        </joint>
        <!-- Four Bars Don't exist in URDF's See mimic for Parallel four bars -->
        <!-- <joint name="${name}_back_left_bogie_joint" type="revolute">
            <origin xyz="0.036626 -0.011901 -0.077732" rpy="0 0 0"/>
            <parent link="${name}_back_left_link"/>
            <child link="${name}_left_bogie"/>
            <axis xyz="1.0 0.0 0.0"/>
            <limit upper="0.2617994" lower="-0.2617994" effort="100" velocity="100"/>
        </joint> -->



        <joint name="${name}_front_right_link_joint" type="fixed">
            <origin xyz="0.244132 -0.220157 0.051277" rpy="0 0 1.5708"/>
            <parent link="${name}_base_origin"/>
            <child link="${name}_front_right_link"/>
            <axis xyz="1.0 0.0 0.0"/>
            <limit upper="0.2617994" lower="-0.2617994" effort="100" velocity="100"/>
            <dynamics damping="2.0" friction="0.2"/>

        </joint>
        <joint name="${name}_back_right_link_joint" type="fixed">
            <origin xyz="0.170002 -0.220157 0.051277" rpy="0 0 1.5708"/>
            <parent link="${name}_base_origin"/>
            <child link="${name}_back_right_link"/>
            <!-- <axis xyz="1.0 0.0 0.0"/> -->
        </joint>
        <joint name="${name}_front_right_bogie_joint" type="fixed">
            <origin xyz="-0.036626 0.054471 -0.076141" rpy="0 0 0"/>
            <parent link="${name}_front_right_link"/>
            <child link="${name}_right_bogie"/>
            <axis xyz="-1.0 0.0 0.0"/>
            <limit upper="0.2617994" lower="-0.2617994" effort="100" velocity="100"/>
            <dynamics damping="2.0" friction="0.2"/>
        </joint>
        <!-- Four bars don't exist in URDF's -->
        <!-- <joint name="${name}_back_right_bogie_joint" type="revolute">
            <origin xyz="-0.036626 -0.019659 -0.076141" rpy="0 0 0"/>
            <parent link="${name}_back_right_link"/>
            <child link="${name}_right_bogie"/>
            <axis xyz="-1.0 0.0 0.0"/>
            <limit upper="0.2617994" lower="-0.2617994" effort="100" velocity="100"/>
        </joint> -->

        <!-- Driven Joints -->

        <joint name="${name}_front_left_wheel_joint" type="continuous">
            <origin xyz="0.188902 -0.225425 -0.000314" rpy="0 0 0"/>
            <parent link="${name}_left_bogie"/>
            <child link="${name}_front_left_wheel"/>
            <axis xyz="1.0 0.0 0.0"/>
        </joint>
        <joint name="${name}_back_left_wheel_joint" type="continuous">
            <origin xyz="0.423979 0.027271 -0.078592" rpy="0 0 0"/>
            <parent link="${name}_rear_bogie"/>
            <child link="${name}_back_left_wheel"/>
            <axis xyz="1.0 0.0 0.0"/>
        </joint>
        <joint name="${name}_middle_left_wheel_joint" type="continuous">
            <origin xyz="0.188902 0.174625 0.000242" rpy="0 0 0"/>
            <parent link="${name}_left_bogie"/>
            <child link="${name}_middle_left_wheel"/>
            <axis xyz="1.0 0.0 0.0"/>
        </joint>


        <joint name="${name}_front_right_wheel_joint" type="continuous">
            <origin xyz="-0.188394 -0.225172 -0.010687" rpy="0 0 0"/>
            <parent link="${name}_right_bogie"/>
            <child link="${name}_front_right_wheel"/>
            <axis xyz="${wheel_direction} 0.0 0.0"/>
        </joint>
        <joint name="${name}_middle_right_wheel_joint" type="continuous">
            <origin xyz="-0.188148 0.174428 0.008279" rpy="0 0 0"/>
            <parent link="${name}_right_bogie"/>
            <child link="${name}_middle_right_wheel"/>
            <axis xyz="${wheel_direction} 0.0 0.0"/>
        </joint>
        <joint name="${name}_back_right_wheel_joint" type="continuous">
            <origin xyz="-0.424281 0.027271 -0.076944" rpy="0 0 0"/>
            <parent link="${name}_rear_bogie"/>
            <child link="${name}_back_right_wheel"/>
            <axis xyz="${wheel_direction} 0.0 0.0"/>
        </joint>

        <gazebo reference="${name}_base_origin">
            <sensor name="imu_sensor" type="imu">
                <always_on>1</always_on>
                <update_rate>100</update_rate>
                <visualize>true</visualize>
                <topic>imu/data/raw</topic>
                <ignition_frame_id>${name}_base_origin</ignition_frame_id>
                <plugin filename="gz-sim-imu-system"
                    name="gz::sim::systems::Imu">
                </plugin>
            </sensor>
        </gazebo>
        <gazebo reference="${name}_base_origin">
            <sensor name="imu_mag" type="magnetometer">
                <always_on>1</always_on>
                <update_rate>100</update_rate>
                <visualize>true</visualize>
                <topic>imu/mag/raw</topic>
                <ignition_frame_id>${name}_base_origin</ignition_frame_id>
                <plugin filename="ignition-gazebo-magnetometer-system"
                    name="ignition::gazebo::systems::Magnetometer">
                </plugin>
            </sensor>
        </gazebo>

        <gazebo reference="${name}_base_origin">
            <sensor name="gps" type="navsat">
                <always_on>true</always_on>
                <update_rate>5</update_rate>
                <visualize>true</visualize>
                <topic>gps/raw</topic>
                <ignition_frame_id>${name}_base_origin</ignition_frame_id>
                <plugin
                    filename="ignition-gazebo-navsat-system"
                    name="ignition::gazebo::systems::NavSat">
                </plugin>

                <navsat>
                    <position_sensing>
                        <horizontal>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.5e-6</stddev>   <!-- meters -->
                            </noise>
                        </horizontal>
                        <vertical>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.0</stddev>
                            </noise>
                        </vertical>
                    </position_sensing>
                </navsat>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>

