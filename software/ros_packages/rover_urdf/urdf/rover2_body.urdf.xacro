                <origin xyz="-0.02062161445617676 0.47305084228515626 0.8411769104003907" rpy="0 0 0"/>
                <mass value="4.270070035395079"/>
                <inertia ixx="0.39903" iyy="0.339892" izz="0.062147" ixy="0.00072" iyz="-0.019354" ixz="0.000192"/>
            </inertial>
            <visual>
                <origin xyz="-0.0 -0.0 -0.0" rpy="0 0 0"/>
                <geometry>
                <mesh filename="package://rover_urdf/urdf/stl_files/mr2526-Tower-URDF_Collision-Unsimplified.stl" scale="0.001 0.001 0.001"/>
