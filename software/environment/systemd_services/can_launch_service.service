[Unit]
Description=ROS2 rover launch
Requires=systemd-udev-settle.service
After=systemd-udev-settle.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/makemorerobot/Rover_2023_2024/software
ExecStart= /home/makemorerobot/Rover_2023_2024/software/startCan.sh
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
