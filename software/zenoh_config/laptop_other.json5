// Zenoh config template for any additional laptop that is NOT the
// scenario-3 designated router (copy this once per extra laptop).
// This device is a router only in scenario 1; a plain client otherwise.
//
// HOW TO USE: uncomment the `mode` + `connect` pair for the scenario
// you're testing, keep the other three scenario blocks commented out.
//
// IPs: Jetson 192.168.1.11 · Pi 192.168.1.10 · Laptop1 192.168.1.6 · Laptop2 192.168.1.8
{
  // ---- Scenario 1: every device runs a router ----
  // (laptops don't connect to each other here — Jetson/Pi are enough
  //  to keep the graph connected, so laptop-to-laptop links are redundant)
  mode: "router",
  connect: { endpoints: ["tcp/192.168.1.11:7447", "tcp/192.168.1.10:7447"] },

  // ---- Scenario 2: Pi + Jetson run routers, this laptop is a client ----
  // mode: "client",
  // connect: { endpoints: ["tcp/192.168.1.10:7447"] },

  // ---- Scenario 3: Jetson + the designated laptop run routers ----
  // (connects to the ground-side laptop router, not across the radio link,
  //  so the wireless hop is only crossed once, by the laptop router)
  // mode: "client",
  // connect: { endpoints: ["tcp/192.168.1.6:7447"] },

  // ---- Scenario 4: only Jetson runs a router, this laptop is a client ----
  // mode: "client",
  // connect: { endpoints: ["tcp/192.168.1.11:7447"] },

  listen: {
    endpoints: ["tcp/0.0.0.0:7447"],
  },

  scouting: {
    multicast: { enabled: true },
    gossip: { enabled: true },
  },
}
